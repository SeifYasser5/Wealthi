generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums — values intentionally mirror the TypeScript union types in types.ts
// ---------------------------------------------------------------------------

enum TransactionType {
  debit
  credit
}

enum Currency {
  EGP
  USD
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Transaction {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// "YYYY-MM" — stored explicitly so monthly queries avoid a date-trunc on nullable transactedAt
  yearMonth       String          @map("year_month") @db.Char(7)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  type            TransactionType
  /// Always positive — direction is encoded in `type`
  amount          Decimal         @db.Decimal(12, 2)
  currency        Currency
  /// Own account id — one of `accounts` in config/wealthi.json
  account         String
  merchant        String?
  /// Manual per-transaction spending category. Null means "not set" — the
  /// spending breakdown then falls back to merchant_categories. A foreign key,
  /// so a transaction can only name a stored category.
  categoryId      Int?            @map("category_id")
  category        Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reportedBalance Decimal?        @map("reported_balance") @db.Decimal(12, 2)
  transactedAt    DateTime        @map("transacted_at") @db.Timestamptz
  /// Non-null only when type = 'transfer'
  counterAccount  String?         @map("counter_account")
  /// chat.db message.guid this row was derived from. Unique so an overlapping
  /// re-read (or a reset cursor) skips the duplicate instead of inserting twice.
  /// Null for non-SMS rows (manual entries / CSV legs) — Postgres permits many nulls.
  messageGuid     String?         @unique @map("message_guid")
  /// chat.db message.ROWID this row was derived from — kept for debugging and
  /// for rebuilding the import cursor if import_state is ever lost.
  sourceRowid     BigInt?         @map("source_rowid")
  /// The SMS body this row was parsed from, cleaned by sanitizeMessageText()
  /// so it is the readable message and nothing else. Shown in the transaction
  /// detail modal and used to diagnose a mis-parse without chat.db.
  /// Null for non-SMS rows (manual entries / CSV legs).
  rawText         String?         @map("raw_text")
  /// The schedule this row is an occurrence of; null for every other row. Set
  /// null when the schedule is deleted, until the next import drops the row.
  scheduleId      Int?            @map("schedule_id")
  schedule        Schedule?       @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([yearMonth, account])
  @@index([yearMonth, categoryId])
  @@index([account, transactedAt(sort: Asc, nulls: Last)])
  @@map("transactions")
}

/// A spending category: what a transaction can be assigned to, edited on the
/// Categories page. `position` is the order every category list shows them in.
/// A category still used by a transaction, a merchant or a schedule can't be
/// deleted: the foreign keys restrict it.
model Category {
  id           Int                @id @default(autoincrement())
  /// Unique; the API also refuses one differing only in case, and "Uncategorized"
  name         String             @unique
  position     Int
  /// Monthly allowance, set on the Budget view of Spending; null means no budget.
  budget       Decimal?           @db.Decimal(12, 2)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz
  transactions Transaction[]
  merchants    MerchantCategory[]
  schedules    Schedule[]
  manualTransactions ManualTransaction[]

  @@map("categories")
}

/// How often a schedule repeats, in units of `interval`.
enum Frequency {
  daily
  weekly
  monthly
  yearly
}

/// A transaction that repeats on its own: rent, a subscription, a salary with
/// no SMS. Edited on the Schedules page. Every import stores one row per
/// occurrence from `startDate` through today (or `endDate`), each marked with
/// this id — so an edit applies to every occurrence at the next import.
model Schedule {
  id         Int             @id @default(autoincrement())
  type       TransactionType
  /// Always positive — direction is encoded in `type`
  amount     Decimal         @db.Decimal(12, 2)
  currency   Currency
  /// Own account id — one of `accounts` in config/wealthi.json
  account    String
  merchant   String
  /// Given to every occurrence; null lets the merchant map decide
  categoryId Int?            @map("category_id")
  category   Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  frequency  Frequency
  /// Every `interval` days/weeks/months/years: 2 with weekly is every other week
  interval   Int             @default(1)
  /// The first occurrence; monthly and yearly ones fall on its day (clamped to
  /// the month's last day)
  startDate  DateTime        @map("start_date") @db.Date
  /// The last day an occurrence may fall on; null repeats indefinitely
  endDate    DateTime?       @map("end_date") @db.Date
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz
  transactions Transaction[]

  @@map("schedules")
}

/// A one-off transaction entered by hand on the Manual page (a bank fee, a
/// reversal, an adjustment) or seeded from config's manualTransactions. It lives
/// here, not only in `transactions`, because every import rebuilds `transactions`
/// from scratch: the import copies each of these into it, so they survive.
model ManualTransaction {
  id         Int             @id @default(autoincrement())
  type       TransactionType
  /// Always positive — direction is encoded in `type`
  amount     Decimal         @db.Decimal(12, 2)
  currency   Currency
  /// Own account id — one of `accounts` in config/wealthi.json
  account    String
  merchant   String
  /// Given to the copied transaction; null lets the merchant map decide
  categoryId Int?            @map("category_id")
  category   Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// The calendar day it happened on (local time)
  date       DateTime        @db.Date
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@index([date])
  @@map("manual_transactions")
}

/// One of your own accounts, edited on the Settings page. Seeded once from
/// config's accounts and openingBalances (db/settings.ts). `id` is what
/// `transactions.account`, `schedules.account` and the other account columns store;
/// those are plain text, so deleting an account is refused in code while any of
/// them (or a source or transfer rule) still names it.
model Account {
  id             String          @id
  label          String
  currency       Currency
  /// The balance at the start of the import's rolling window (see AGENTS.md),
  /// the number the first computed month opens from.
  openingBalance Decimal         @default(0) @map("opening_balance") @db.Decimal(12, 2)
  /// The order every account list shows them in
  position       Int
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  sources        AccountSource[]
  transferRules  TransferRule[]  @relation("RuleAccount")
  counterRules   TransferRule[]  @relation("RuleCounterAccount")

  @@map("accounts")
}

/// Which account a source key lands on. A pattern match yields "<bank>:<last4>"
/// and never names an account; this maps it to one. Seeded once from config's accountSources.
model AccountSource {
  source    String  @id
  accountId String  @map("account_id")
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@map("account_sources")
}

/// Tags a parsed leg as an internal transfer: a debit or credit on `account`
/// with this merchant becomes a transfer to `counterAccount`. An empty merchant
/// matches any merchant on that account and direction. Seeded once from config's transferRules.
model TransferRule {
  id               Int             @id @default(autoincrement())
  accountId        String          @map("account_id")
  account          Account         @relation("RuleAccount", fields: [accountId], references: [id], onDelete: Restrict)
  /// Which leg this matches — debit = money out, credit = money in
  type             TransactionType
  /// Exactly as the bank prints it; empty matches any merchant
  merchant         String          @default("")
  counterAccountId String          @map("counter_account_id")
  counterAccount   Account         @relation("RuleCounterAccount", fields: [counterAccountId], references: [id], onDelete: Restrict)

  @@unique([accountId, type, merchant])
  @@index([counterAccountId])
  @@map("transfer_rules")
}

/// The chat.db handle.id (display name or phone number) a bank sends SMS from.
/// Only messages from these handles are imported or learned from. Seeded once from config's bankSenders.
model BankSender {
  sender String @id

  @@map("bank_senders")
}

/// The merchant map: a transaction with no manual category counts towards its
/// merchant's. Seeded once from config's merchantCategories (db/categories.ts).
model MerchantCategory {
  /// Merchant exactly as printed by the bank
  merchant   String   @id
  categoryId Int      @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@map("merchant_categories")
}

/// Single-row watermark for incremental imports. Holds the highest chat.db
/// message.ROWID we have already scanned; the next import reads only rows with
/// a greater ROWID. Advanced inside the same transaction as the inserts so the
/// cursor can never move ahead of the data it represents.
model ImportState {
  id        Int      @id @default(1)
  lastRowid BigInt   @map("last_rowid")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  @@map("import_state")
}

/// Materialized monthly snapshot per account. Derived from `transactions`
/// (the source of truth) so incremental imports only recompute from the
/// earliest touched month forward, instead of replaying history from genesis.
model MonthlyBalance {
  /// "YYYY-MM" — join key to Transaction.yearMonth and the cascade chain
  yearMonth           String    @map("year_month") @db.Char(7)
  /// Own account id — one of `accounts` in config/wealthi.json
  account             String
  openingBalance      Decimal   @map("opening_balance") @db.Decimal(12, 2)
  debits              Decimal   @db.Decimal(12, 2)
  credits             Decimal   @db.Decimal(12, 2)
  transfersIn         Decimal   @map("transfers_in") @db.Decimal(12, 2)
  transfersOut        Decimal   @map("transfers_out") @db.Decimal(12, 2)
  closingBalance      Decimal   @map("closing_balance") @db.Decimal(12, 2)
  lastReportedBalance Decimal?  @map("last_reported_balance") @db.Decimal(12, 2)
  discrepancy         Decimal?  @db.Decimal(12, 2)
  computedAt          DateTime  @default(now()) @map("computed_at") @db.Timestamptz

  @@id([yearMonth, account])
  @@map("monthly_balances")
}

/// Where a learned pattern stands. Learn adds new ones as `pending`; the Learn
/// page's review turns each into `enabled` or `disabled`. Only enabled ones parse.
enum PatternStatus {
  pending
  enabled
  disabled
}

/// A learned SMS template (services/patterns/). The import builds its parser
/// from the enabled rows at the start of every run, so a change here applies
/// to the next import without a restart.
model SmsPattern {
  /// "<bank>:<hash of the mined template>" — stable across learn runs, so a
  /// relearn recognises a template it has already stored
  id        String        @id
  /// bankOf(sender), e.g. "adcb-egypt"; a message is matched against its bank's patterns
  bank      String
  status    PatternStatus @default(pending)
  /// debit | credit | by-keyword
  type      String
  pattern   String
  /// What the latest learn run produced; differs from `pattern` once the labeller changes
  generated String
  /// Why learn labelled it this way
  reason    String
  /// Things to check before enabling
  review    String[]
  /// Messages it matched in the latest learn run
  messages  Int
  /// Not produced by the latest learn run of its bank (kept so its status isn't lost)
  missing   Boolean       @default(false)
  learnedAt DateTime      @default(now()) @map("learned_at") @db.Timestamptz
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status])
  @@map("sms_patterns")
}
