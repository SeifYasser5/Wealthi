generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums — values intentionally mirror the TypeScript union types in types.ts
// ---------------------------------------------------------------------------

enum TransactionType {
  debit
  credit
}

enum Currency {
  EGP
  USD
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Transaction {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// "YYYY-MM" — stored explicitly so monthly queries avoid a date-trunc on nullable transactedAt
  yearMonth       String          @map("year_month") @db.Char(7)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  type            TransactionType
  /// Always positive — direction is encoded in `type`
  amount          Decimal         @db.Decimal(12, 2)
  currency        Currency
  /// Own account id — one of `accounts` in config/wealthi.json
  account         String
  merchant        String?
  /// Manual per-transaction spending category. Null means "not set" — the
  /// spending breakdown then falls back to the merchant map in utils/categories.ts.
  category        String?
  reportedBalance Decimal?        @map("reported_balance") @db.Decimal(12, 2)
  transactedAt    DateTime        @map("transacted_at") @db.Timestamptz
  /// Non-null only when type = 'transfer'
  counterAccount  String?         @map("counter_account")
  /// chat.db message.guid this row was derived from. Unique so an overlapping
  /// re-read (or a reset cursor) skips the duplicate instead of inserting twice.
  /// Null for non-SMS rows (manual entries / CSV legs) — Postgres permits many nulls.
  messageGuid     String?         @unique @map("message_guid")
  /// chat.db message.ROWID this row was derived from — kept for debugging and
  /// for rebuilding the import cursor if import_state is ever lost.
  sourceRowid     BigInt?         @map("source_rowid")

  @@index([yearMonth, account])
  @@index([yearMonth, category])
  @@index([account, transactedAt(sort: Asc, nulls: Last)])
  @@map("transactions")
}

/// Single-row watermark for incremental imports. Holds the highest chat.db
/// message.ROWID we have already scanned; the next import reads only rows with
/// a greater ROWID. Advanced inside the same transaction as the inserts so the
/// cursor can never move ahead of the data it represents.
model ImportState {
  id        Int      @id @default(1)
  lastRowid BigInt   @map("last_rowid")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  @@map("import_state")
}

/// Materialized monthly snapshot per account. Derived from `transactions`
/// (the source of truth) so incremental imports only recompute from the
/// earliest touched month forward, instead of replaying history from genesis.
model MonthlyBalance {
  /// "YYYY-MM" — join key to Transaction.yearMonth and the cascade chain
  yearMonth           String    @map("year_month") @db.Char(7)
  /// Own account id — one of `accounts` in config/wealthi.json
  account             String
  openingBalance      Decimal   @map("opening_balance") @db.Decimal(12, 2)
  debits              Decimal   @db.Decimal(12, 2)
  credits             Decimal   @db.Decimal(12, 2)
  transfersIn         Decimal   @map("transfers_in") @db.Decimal(12, 2)
  transfersOut        Decimal   @map("transfers_out") @db.Decimal(12, 2)
  closingBalance      Decimal   @map("closing_balance") @db.Decimal(12, 2)
  lastReportedBalance Decimal?  @map("last_reported_balance") @db.Decimal(12, 2)
  discrepancy         Decimal?  @db.Decimal(12, 2)
  computedAt          DateTime  @default(now()) @map("computed_at") @db.Timestamptz

  @@id([yearMonth, account])
  @@map("monthly_balances")
}
